{
  "manifest_version": 3,
  "name": "ScanPNL",
  "short_name": "ScanPNL",
  "version": "1.0.1",
  "version_name": "Beta 1.0.1",
  "minimum_chrome_version": "125",
  "description": "Instant trade controls, positions, chart fills, and live P&L for supported crypto terminals.",
  "icons": {
    "16": "assets/scanpnl-icon-16.png",
    "32": "assets/scanpnl-icon-32.png",
    "48": "assets/scanpnl-icon-48.png",
    "128": "assets/scanpnl-icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/scanpnl-icon-16.png",
      "32": "assets/scanpnl-icon-32.png",
      "48": "assets/scanpnl-icon-48.png",
      "128": "assets/scanpnl-icon-128.png"
    },
    "default_title": "ScanPNL",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://*.axiom.trade/*",
    "https://axiom.trade/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*"],
      "js": ["bootstrap.js"],
      "run_at": "document_start"
    }
  ]
}
